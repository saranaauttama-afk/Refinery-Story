  "dependencies": {
    "@expo-google-fonts/baloo-2": "0.4.2",
    "@expo-google-fonts/pixelify-sans": "0.4.2",
    "@expo/metro-runtime": "~56.0.15",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@shopify/react-native-skia": "^2.6.9",
    "expo": "~56.0.11",
    "expo-audio": "56.0.12",
    "expo-constants": "~56.0.18",
    "expo-font": "56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.10",
    "expo-status-bar": "~56.0.4",
    "lucide-react-native": "1.18.0",
    "react": "19.2.7",
    "react-dom": "^19.2.7",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "3.0.1",
    "react-native-reanimated": "4.4.1",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "^4.25.2",
